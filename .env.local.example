# AWS SES — usado por app/api/contact/route.ts para enviar el formulario de contacto por email.
# Copiá este archivo a .env.local y completá los valores reales (.env.local no se sube a git).

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Dirección "From" — debe estar verificada en SES (o pertenecer a un dominio verificado).
SES_FROM_EMAIL=no-reply@gritcg.com

# Dirección donde se reciben los mensajes del formulario.
SES_TO_EMAIL=info@gritcg.com
